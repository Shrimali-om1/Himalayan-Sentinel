# Optional: PostgreSQL/PostGIS connection. Omit to use local SQLite demo storage.
DATABASE_URL=postgresql+psycopg://postgres:replace-me@localhost:5432/himalayan_sentinel
POSTGRES_PASSWORD=replace-me
# Browser-visible backend URL (copy this value to frontend/.env.local if changing it)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# Comma-separated browser origins allowed by the API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set false only when you have initialized a reviewed non-demo database.
DEMO_MODE=true

